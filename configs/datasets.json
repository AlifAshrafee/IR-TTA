{
  "_comment": "'{root}' expands to _root (relative paths are relative to the repository). Sets without 'lq' but with 'noise_sigma' are synthesised deterministically (irtta/data.py). 'metric': 'y' = reported in BT.601 Y-PSNR. Test sets: Rain100H, SOTS_Indoor, DenseHaze, OHAZY, Kodak24_Poisson (+ HIDE, LOLv2_Syn, DPDD for 5-task sources). No-shift sets (the sources' own test distributions): BSD68_s*, Rain100L, SOTS_Outdoor, GoPro, LOL. Oracle analysis only: HIDE_val, LOLv2_Syn_val (targets) and *_train (real pairs).",
  "_root": "../AiO-Datasets",
  "_banks": {
    "default": "{root}/Train/deblur/DIV2K/DIV2K_train_HR",
    "_note": "clean images of our synthetic pairs: DIV2K train HR (300 evenly spaced images are used)"
  },
  "Rain100H": {
    "lq": "{root}/Test/derain/Rain100H/LQ",
    "gt": "{root}/Test/derain/Rain100H/GT",
    "split": "test",
    "task": "derain",
    "metric": "y"
  },
  "SOTS_Indoor": {
    "lq": "{root}/Test/dehaze/SOTS_Indoor/LQ",
    "gt": "{root}/Test/dehaze/SOTS_Indoor/GT",
    "split": "test",
    "task": "dehaze"
  },
  "DenseHaze": {
    "lq": "{root}/Test/dehaze/DenseHaze/LQ",
    "gt": "{root}/Test/dehaze/DenseHaze/GT",
    "split": "test",
    "task": "dehaze"
  },
  "OHAZY": {
    "lq": "{root}/Test/dehaze/O-HAZY/LQ",
    "gt": "{root}/Test/dehaze/O-HAZY/GT",
    "split": "test",
    "task": "dehaze",
    "max_side": 800,
    "note": "LQ and GT downsampled at load time (bicubic) to an 800-px long side"
  },
  "Kodak24_Poisson": {
    "lq": "{root}/Test/denoise/Kodak24_Poisson/LQ",
    "gt": "{root}/Test/denoise/Kodak24_Poisson/GT",
    "split": "test",
    "task": "denoise",
    "note": "Poisson noise, peak 30, seed 0"
  },
  "HIDE": {
    "lq": "{root}/Test/deblur/HIDE/LQ",
    "gt": "{root}/Test/deblur/HIDE/GT",
    "split": "test",
    "task": "deblur"
  },
  "LOLv2_Syn": {
    "lq": "{root}/Test/enhance/LOL_v2_Synthetic/LQ",
    "gt": "{root}/Test/enhance/LOL_v2_Synthetic/GT",
    "split": "test",
    "task": "enhance"
  },
  "DPDD": {
    "lq": "{root}/Test/deblur/DPDD/LQ",
    "gt": "{root}/Test/deblur/DPDD/GT",
    "split": "test",
    "task": "deblur",
    "note": "DPDD (Abuolaim & Brown, ECCV 2020), Canon test split, 76 scenes: test_c/source -> LQ, test_c/target -> GT (tools/prepare_dpdd.py)"
  },
  "BSD68_s15": {
    "gt": "{root}/Test/denoise/BSD68",
    "noise_sigma": 15,
    "noise_seed": 0,
    "split": "noshift",
    "task": "denoise"
  },
  "BSD68_s25": {
    "gt": "{root}/Test/denoise/BSD68",
    "noise_sigma": 25,
    "noise_seed": 0,
    "split": "noshift",
    "task": "denoise"
  },
  "BSD68_s50": {
    "gt": "{root}/Test/denoise/BSD68",
    "noise_sigma": 50,
    "noise_seed": 0,
    "split": "noshift",
    "task": "denoise"
  },
  "Rain100L": {
    "lq": "{root}/Test/derain/Rain100L/LQ",
    "gt": "{root}/Test/derain/Rain100L/GT",
    "split": "noshift",
    "task": "derain",
    "metric": "y"
  },
  "SOTS_Outdoor": {
    "lq": "{root}/Test/dehaze/SOTS_Outdoor/LQ",
    "gt": "{root}/Test/dehaze/SOTS_Outdoor/GT",
    "split": "noshift",
    "task": "dehaze"
  },
  "GoPro": {
    "lq": "{root}/Test/deblur/GoPro/LQ",
    "gt": "{root}/Test/deblur/GoPro/GT",
    "split": "noshift",
    "task": "deblur"
  },
  "LOL": {
    "lq": "{root}/Test/enhance/LOL_v1/LQ",
    "gt": "{root}/Test/enhance/LOL_v1/GT",
    "split": "noshift",
    "task": "enhance"
  },
  "HIDE_val": {
    "lq": "{root}/Train/deblur/HIDE/LQ",
    "gt": "{root}/Train/deblur/HIDE/GT",
    "split": "val",
    "task": "deblur",
    "note": "oracle analysis target: 300 evenly spaced images of the HIDE training split"
  },
  "LOLv2_Syn_val": {
    "lq": "{root}/Train/enhance/LOL_v2_Synthetic/LQ",
    "gt": "{root}/Train/enhance/LOL_v2_Synthetic/GT",
    "split": "val",
    "task": "enhance",
    "note": "oracle analysis target: 300 evenly spaced images of the LOLv2-Synthetic training split"
  },
  "HIDE_train": {
    "lq": "{root}/Train/deblur/HIDE/LQ",
    "gt": "{root}/Train/deblur/HIDE/GT",
    "split": "train",
    "task": "deblur",
    "note": "oracle pairs for HIDE_val (the evaluated images are excluded)"
  },
  "LOLv2_Syn_train": {
    "lq": "{root}/Train/enhance/LOL_v2_Synthetic/LQ",
    "gt": "{root}/Train/enhance/LOL_v2_Synthetic/GT",
    "split": "train",
    "task": "enhance",
    "note": "oracle pairs for LOLv2_Syn_val (the evaluated images are excluded)"
  },
  "DPDD_train": {
    "lq": "{root}/Train/deblur/DPDD/LQ",
    "gt": "{root}/Train/deblur/DPDD/GT",
    "split": "train",
    "task": "deblur",
    "note": "oracle pairs for DPDD: the Canon validation split (val_c, 74 pairs; source -> LQ, target -> GT)"
  }
}
